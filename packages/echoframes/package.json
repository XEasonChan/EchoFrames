  "peerDependencies": {
    "remotion": ">=4.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "playwright": "^1.45.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
